{
  "extends": ["nitro/tsconfig"],
  "compilerOptions": {
    "strict": true,
    "paths": {
      "~/*": ["./*"]
    },
    "types": [
      "vue",
      "@vue/compiler-sfc",
      "@unhead/vue",
      "vue-router",
      "unplugin-vue-router/client",
      "vite/client"
    ]
  },
  "include": ["**/*.ts", "**/*.vue", "auto-imports.d.ts", "typed-router.d.ts"]
}
